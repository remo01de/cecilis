# Cecilia Chat Backend - Environment Variables

# OpenRouter (Chat, Bildgenerierung, Websuche) - https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Chat-Modell (beliebige OpenRouter-Modell-ID, z.B. openai/gpt-5-mini)
OPENROUTER_MODEL=openai/gpt-5-mini

# Temperatur (optional - leer lassen, wenn das Modell den Parameter nicht unterstuetzt)
OPENROUTER_TEMPERATURE=0.9
OPENROUTER_SUMMARY_TEMPERATURE=0.3

# Bildgenerierung (optional)
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5

# Websuche (optional; Standard: Chat-Modell mit Exa-Suche)
# OPENROUTER_SEARCH_MODEL=openai/gpt-5-mini
# OPENROUTER_SEARCH_ENGINE=exa

# Nur auf diesen Seiten suchen (kommagetrennt, optional). Ohne Angabe wird überall
# gesucht, ausser auf einer eingebauten Sperrliste (Erwachsenen-, Glücksspielseiten …).
# Beispiel für eine kindgerechte Positivliste:
# SEARCH_INCLUDE_DOMAINS=wikipedia.org,klexikon.zum.de,kinderzeitmaschine.de,srf.ch,zdf.de,wdrmaus.de,geo.de,meteoschweiz.admin.ch

# Server Configuration
PORT=30000
NODE_ENV=development

# CORS (optional, kommagetrennt): Nur nötig, wenn das Frontend von einer ANDEREN Adresse
# als das Backend geladen wird. In development ist localhost auf jedem Port erlaubt.
# ALLOWED_ORIGINS=https://cecilia.example.ch

# Datenbank für Konten (Standard: data/cecilia.db im Projektordner, im Docker-Image /app/data/cecilia.db)
# DB_PATH=/app/data/cecilia.db

# Erstes Admin-Konto: wird NUR beim allerersten Start mit leerer Datenbank angelegt.
# Danach werden diese Werte nicht mehr verwendet – Konten verwaltest du auf /admin.html.
user=name@example.com
passwort=Mein_Geheimes_Passwort
